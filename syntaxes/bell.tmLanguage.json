{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "bell",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#symbols"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line",
                    "match": "#[#!](?!=).*"
                },
                {
                    "name": "comment.block",
                    "begin": "#\\(",
                    "end": "\\)#"
                }
            ]
        },
        "symbols": {
            "patterns": [
                {
                    "name": "string.quoted.double",
                    "begin": "\"",
                    "end": "\""
                },
                {
                    "name": "string.quoted.single",
                    "begin": "'",
                    "end": "'"
                },
                {
                    "name": "string.unquoted",
                    "match": "`\\S+(?:\\s|$)"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.other",
                    "begin": "((?<=\\b|^)(?<!\\$|#)include(?=\\())",
                    "end": "\\)"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword",
                    "match": "(?<!\\$|#)(for|init|do|collect|if|while|then|else|in|keep|unkeep|with|as)(?=\\b)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function",
                    "match": "(\\$?[A-Za-z]\\w*)(?=\\()"
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "name": "constant.numeric",
                    "match": "((?<!\\$|#)(?<=\\b)[A-Ga-g][#bxdq\\^v]*[0-9]+(?:[+-]\\d+/\\d+t)?(?=\\b))"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.other",
                    "match": "(?<=\\b)(?<!\\$|#)(null|nil|pi)(?=\\b)"
                },
                {
                    "name": "constant.other",
                    "match": "((?<!\\w)\\$(?:args|argcount)(?=\\b|$))"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.parameter",
                    "match": "(?<![a-zA-Z$#_@])(\\$|#)(?!(\\$|#))(?=[A-Za-z])\\b"
                }
            ]
        }
    },
    "scopeName": "source.bell"
}