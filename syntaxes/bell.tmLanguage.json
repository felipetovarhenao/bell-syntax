{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "bell",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#symbols"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line",
                    "match": "#[#!](?!=).*"
                },
                {
                    "name": "comment.block",
                    "begin": "#\\(",
                    "end": "\\)#"
                }
            ]
        },
        "symbols": {
            "patterns": [
                {
                    "name": "string.quoted.double",
                    "begin": "\"",
                    "end": "\""
                },
                {
                    "name": "string.quoted.single",
                    "begin": "'",
                    "end": "'"
                },
                {
                    "name": "string.unquoted",
                    "match": "`\\S+(?:\\s|$)"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.other",
                    "begin": "((?<=\\b|^)(?<!\\$|#)include(?=\\())",
                    "end": "\\)"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword",
                    "match": "(?<!\\$|#)(for|init|do|collect|if|while|then|else|in|keep|unkeep|with|as)(?=\\b)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function",
                    "match": "((?<=[$|#]?)[A-Za-z]\\w*)(?=\\()"
                },
                {
                    "name": "support.function",
                    "match": "(#(?:\\+|-|u-|\\*|/{1,2}|%|==|!=|<=|>=|<{1,2}|>{1,2}|&{1,3}|\\^{1,2}|\\|{1,3}))"
                },
                {
                    "name": "support.function",
                    "match": "(?<=\\{)\\s*\\w+(\\.\\w+)?\\b(?=([^}]*\\}))"
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "name": "constant.numeric",
                    "match": "(?<![A-Za-z_0-9$#@)\\]])[+\\-]?\\d+\/\\d+"
                },
                {
                    "name": "constant.numeric",
                    "match": "((?<![A-Za-z_0-9$#@)\\]])[+\\-]?(\\d+(\\.(?!\\.\\.))\\d*|\\d*((?<!\\.\\.)\\.)\\d+|\\d+)([eE][+\\-]?\\d+)?(?!\\w))"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.other",
                    "match": "(?<=\\b)(?<!\\$|#)(null|nil|pi)(?=\\b)"
                },
                {
                    "name": "constant.numeric",
                    "match": "((?<!\\$|#)(?<=\\b)[A-Ga-g][#bxdq\\^v]*[0-9]+(?:[+-]\\d+/\\d+t)?(?=\\b))"
                },
                {
                    "name": "constant.other",
                    "match": "((?<!\\w)\\$(?:args|argcount)(?=\\b|$))"
                },
                {
                    "name": "support.constant",
                    "match": "((?<!\\w)\\$(?:[lipfr]|d?[xo])\\d+(?=\\b|$))"
                },
                {
                    "name": "support.constant",
                    "match": "(?<!\\$)\\b[A-Z][A-Z_]*?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator",
                    "match": "((?:!|=|<|>)=)"
                },
                {
                    "name": "keyword.operator",
                    "match": "((?:\\.|!?_|:|\\+|-|\\*{1,2}|\/{1,2}|%|\\^{1,2}|>{1,2}|<{1,2}|&{1,3}|\\|{1,3})?=)"
                },
                {
                    "name": "keyword.operator",
                    "match": "((?<!#)!|~|u?-|\\+(?=[\\[\\(]|(?:[$|#]?[A-Za-z0-9])))"
                },
                {
                    "name": "keyword.operator",
                    "match": ";"
                },
                {
                    "name": "keyword.operator",
                    "match": "(\\+|-|\\*{1,2}|:{1,2}|\\.|\/{1,2}|%|\\^{1,2}|>{1,2}|<{1,2}|&{1,3}|\\|{1,3})"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.parameter",
                    "match": "(?<![a-zA-Z$#_@])(\\$|#)(?!(\\$|#))(?=[A-Za-z])\\b"
                },
                {
                    "name": "support.type.property-name",
                    "match": "(?<!(?:@|\\w)+)(@[A-Za-z]\\w*(?=\\s))"
                }
            ]
        }
    },
    "scopeName": "source.bell"
}